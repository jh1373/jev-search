{
  "name": "jev-search",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "author": "jh",
  "license": "MIT",
  "description": "Local-first Obsidian search with opt-in Jev reranking",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:live": "node scripts/smoke-live.mjs",
    "build": "node scripts/build.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "test:gui": "node scripts/run-gui-e2e.mjs",
    "test:mock": "node scripts/verify-at-mock.mjs",
    "test:integrity": "node scripts/verify-integrity.mjs",
    "test:at12": "node scripts/verify-at12.mjs",
    "test:at18": "node scripts/verify-at18.mjs",
    "test:at20": "node scripts/verify-at20.mjs",
    "test:load": "node scripts/load-test.mjs",
    "test:at11-large": "node scripts/verify-at11-large.mjs",
    "test:release": "node scripts/verify-release.mjs",
    "test:release:zip": "node scripts/package-release.mjs",
    "test:live:key": "node scripts/live-with-stored-key.mjs",
    "test:ndcg": "node scripts/measure-ndcg.mjs",
    "bench:public": "node scripts/fetch-public-corpus.mjs",
    "test:bundle": "node scripts/verify-bundle.mjs",
    "bench:corpus": "node scripts/gen-corpus.mjs",
    "bench:recall": "node scripts/measure-recall.mjs",
    "verify": "npm run check && npm run test:bundle"
  },
  "engines": {"node": ">=22.18.0"},
  "devDependencies": {
    "@types/node": "22.20.3",
    "esbuild": "0.28.2",
    "obsidian": "1.13.1",
    "typescript": "7.0.2"
  }
}
